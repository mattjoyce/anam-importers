{
  "meta": {
    "facet_type": "health.measurement",
    "definition_version": 4,
    "kind": "reading",
    "family": "body",
    "classification": "Sensitive",
    "validation_mode": "strict",
    "source_schema": "withings/measurement",
    "schema_version": 2,
    "time_semantics": {
      "fact_time": {"pointer": "/date", "layout": "2006-01-02 15:04:05", "zone": "UTC"}
    },
    "identity_key": ["/withings_id", "/type"],
    "min_binding_assurance": "medium"
  },
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["withings_id", "date", "type", "value", "unit"],
    "properties": {
      "attrib": {"type": "string", "minLength": 1, "pattern": "^[0-9]+$"},
      "date": {"type": "string", "minLength": 1},
      "deviceid": {"type": "string", "minLength": 1, "pattern": "^[0-9a-f]+$"},
      "model": {"type": "string", "minLength": 1},
      "timezone": {"type": "string", "minLength": 1},
      "type": {"type": "string", "minLength": 1},
      "unit": {"type": "string", "minLength": 1},
      "value": {"type": "string", "minLength": 1, "pattern": "^-?[0-9]+(\\.[0-9]+)?$"},
      "withings_id": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  }
}
